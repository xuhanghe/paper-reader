#!/usr/bin/env bash
# One command from a fresh clone to the reader open in your browser.
#
#   ./start
#
# It checks for Node.js (the one thing it cannot install for you), then the
# launcher installs the dependencies the first time or whenever they change,
# starts the server, and opens the reader once the server answers. From there
# the setup assistant inside the app connects Zotero and a coding agent. Stop
# it with Ctrl-C. On Windows, start.cmd is the same thing.
#
#   PORT=3100 ./start              # a fixed port instead of the next free one
#   PAPER_READER_NO_OPEN=1 ./start # don't open a browser (servers, tests)
set -euo pipefail
cd "$(dirname "$0")"

# A GUI-launched terminal can miss the places Node installs to; look there too
for dir in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/.volta/bin" "$HOME/.nvm/versions/node"/*/bin "$HOME/.fnm/aliases/default/bin"; do
  [ -d "$dir" ] && case ":$PATH:" in *":$dir:"*) ;; *) PATH="$PATH:$dir" ;; esac
done
export PATH

if ! command -v node >/dev/null 2>&1; then
  echo "Paper Reader needs Node.js 20 or newer, and this machine has none."
  case "$(uname -s)" in
    Darwin) echo "  Install it with:   brew install node        (or from https://nodejs.org)";;
    *)      echo "  Install it from:   https://nodejs.org   (or your package manager: apt, dnf, pacman…)";;
  esac
  echo "Then run ./start again."
  exit 1
fi
major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$major" -lt 20 ]; then
  echo "Paper Reader needs Node.js 20 or newer; this is $(node --version)."
  echo "  Update it from https://nodejs.org (or: brew upgrade node), then run ./start again."
  exit 1
fi

exec node scripts/start.mjs

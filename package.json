{
  "name": "paper_reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --require tsx/cjs --test '__tests__/**/*.test.ts'",
    "desktop": "env -u ELECTRON_RUN_AS_NODE electron desktop/main.cjs --dev",
    "desktop:build": "next build && electron-builder --mac"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "next": "16.2.6",
    "pdfjs-dist": "^5.4.296",
    "playwright-core": "^1.62.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.paper-reader.app",
    "productName": "Paper Reader",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "desktop/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null
    },
    "afterPack": "desktop/after-pack.cjs"
  }
}
